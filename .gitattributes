# Preserve the bytes bound by NXP provenance hashes across platforms.
data/board-sources/nxp-frdm-mcxn236/original-design-files/** -text
data/board-sources/nxp-frdm-mcxn236/schematic-reference-index.json -text
data/board-sources/nxp-frdm-mcxn236/structured-rev-c/** -text
# Preserve hash-addressed generated export payloads and source metadata.
data/board-sources/**/generated-kicad/** -text
# Annotation and acquisition manifests participate in raw-byte SHA-256 joins.
annotations/*.json -text
data/external/PCBVision/*.json -text
data/photo-model/*.json -text
# Preserve hash-addressed source CRLF bytes without treating CR as trailing whitespace.
data/phone-captures/**/*.json -text whitespace=cr-at-eol
data/ar-alignment/*.json -text whitespace=cr-at-eol
data/board-sources/**/ar-reference/*.json -text whitespace=cr-at-eol
data/board-sources/**/structured-source/*.json -text
